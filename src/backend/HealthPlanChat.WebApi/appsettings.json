{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "App": {
    "SessionTtlMinutes": 60,
    "MaxMessagesPerSession": 50,
    "MaxMessageLength": 4000
  },

  "Retrieval": {
    "MinHits": 1,
    "MinTopScore": 0.7,
    "TopK": 5
  },

  "Redis": {
    "ConnectionString": "",
    "KeyPrefix": "session:"
  },

  "Search": {
    "Endpoint": "",
    "IndexName": "plan-materials"
  },

  "Foundry": {
    "Endpoint": "",
    "ChatModelDeployment": "gpt-4o",
    "EmbeddingModelDeployment": "text-embedding-3-small",
    "MaxTokens": 1024,
    "Temperature": 0.7
  },

  "Storage": {
    "BlobServiceUrl": "",
    "ContainerName": "plan-materials"
  }
}
