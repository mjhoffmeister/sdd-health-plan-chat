{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "// INSTRUCTIONS": "Copy this file to appsettings.Development.local.json and fill in values. The .local.json file is gitignored.",

  "Azure": {
    "SearchEndpoint": "https://<your-search-service>.search.windows.net",
    "SearchIndexName": "plan-materials",
    "StorageAccountUri": "https://<your-storage-account>.blob.core.windows.net",
    "StorageContainerName": "plan-materials",
    "RedisConnectionString": "<your-redis-connection-string>",
    "FoundryEndpoint": "https://<your-foundry-endpoint>.cognitiveservices.azure.com",
    "FoundryModelDeploymentName": "gpt-5-mini",
    "FoundryEmbeddingDeploymentName": "text-embedding-3-small"
  },

  "Retrieval": {
    "MinHits": 1,
    "MinTopScore": 0.7
  },

  "Session": {
    "TtlMinutes": 60,
    "MaxMessages": 50
  }
}
