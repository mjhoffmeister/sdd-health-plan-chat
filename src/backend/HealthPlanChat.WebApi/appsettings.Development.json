{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "// INSTRUCTIONS": "Copy this file to appsettings.Development.local.json and fill in values. The .local.json file is gitignored.",

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://localhost:5001",
      "https://localhost:5001",
      "http://localhost:5173"
    ]
  },

  "App": {
    "SessionTtlMinutes": 60,
    "MaxMessagesPerSession": 50,
    "MaxMessageLength": 4000
  },

  "Retrieval": {
    "MinHits": 1,
    "MinTopScore": 0.7,
    "TopK": 5
  },

  "Redis": {
    "Endpoint": "<your-redis-host>.redis.azure.net:10000",
    "KeyPrefix": "session:"
  },

  "Search": {
    "Endpoint": "https://<your-search-service>.search.windows.net",
    "IndexName": "plan-materials"
  },

  "Foundry": {
    "Endpoint": "https://<your-foundry-endpoint>.cognitiveservices.azure.com",
    "ChatModelDeployment": "gpt-5-mini",
    "EmbeddingModelDeployment": "text-embedding-3-small",
    "MaxTokens": 1024,
    "Temperature": 0.7
  },

  "Storage": {
    "BlobServiceUrl": "https://<your-storage-account>.blob.core.windows.net",
    "ContainerName": "plan-materials"
  }
}
