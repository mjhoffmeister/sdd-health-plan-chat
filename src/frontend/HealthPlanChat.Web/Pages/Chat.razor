@page "/"
@page "/chat"
@layout ChatLayout
@using HealthPlanChat.Web.Services
@using HealthPlanChat.Web.Components
@using HealthPlanChat.Web.Layout
@inject ChatSessionService ChatSession
@inject ThemeService ThemeService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Health Plan Chat</PageTitle>

<div class="chat-container">
    <header class="chat-header">
        <div class="chat-header-actions">
            <NewChatButton />
        </div>
        <div class="chat-header-content">
            <h1>Health Plan Chat</h1>
            <p class="subtitle">Ask questions about available health plans</p>
        </div>
        <div class="chat-header-actions">
            <ThemeToggle />
        </div>
    </header>

    @if (!string.IsNullOrEmpty(ChatSession.Error))
    {
        <div class="error-banner">
            <span class="error-icon">⚠️</span>
            @ChatSession.Error
        </div>
    }

    <div class="messages-container" @ref="_messagesContainer">
        @if (!ChatSession.HasSession && !ChatSession.IsLoading)
        {
            <div class="welcome-message">
                <h2>Welcome!</h2>
                <p>Ask questions about the health plans available in our system.</p>
                <p class="hint">Examples:</p>
                <ul>
                    <li>"What plans are available?"</li>
                    <li>"Compare the HMO and PPO deductibles"</li>
                    <li>"What does the Gold plan cover for physical therapy?"</li>
                </ul>
            </div>
        }

        @foreach (var message in ChatSession.Messages)
        {
            <div class="message @(message.Role == MessageRole.User ? "user" : "assistant")">
                <div class="message-header">
                    <span class="role">@(message.Role == MessageRole.User ? "You" : "Assistant")</span>
                    @if (message.AnswerType.HasValue)
                    {
                        <AnswerTypeBadge Type="@message.AnswerType.Value" />
                    }
                    <span class="timestamp">@message.Timestamp.ToShortTimeString()</span>
                </div>
                <div class="message-content">
                    @if (message.Role == MessageRole.Assistant)
                    {
                        <MarkdownRenderer Text="@message.Text" />
                    }
                    else
                    {
                        @message.Text
                    }
                </div>
                @if (message.AnswerType.HasValue)
                {
                    <AnswerDisclaimer Type="@message.AnswerType.Value" />
                }
                @if (message.References.Count > 0)
                {
                    <ReferencesList References="@message.References" />
                }
            </div>
        }

        @if (ChatSession.IsLoading)
        {
            <div class="message assistant loading">
                <div class="message-header">
                    <span class="role">Assistant</span>
                </div>
                <div class="message-content">
                    <span class="typing-indicator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </div>
            </div>
        }
    </div>

    <div class="input-container">
        <form @onsubmit="HandleSubmit">
            <input
                type="text"
                @bind="_inputMessage"
                @bind:event="oninput"
                placeholder="Type your question..."
                disabled="@ChatSession.IsLoading"
                class="message-input" />
            <button type="submit" disabled="@(ChatSession.IsLoading || string.IsNullOrWhiteSpace(_inputMessage))" class="send-button">
                Send
            </button>
        </form>
    </div>
</div>

@code {
    private string _inputMessage = string.Empty;
    private ElementReference _messagesContainer;
    private int _previousMessageCount = 0;
    private bool _wasLoading = false;

    protected override async Task OnInitializedAsync()
    {
        ChatSession.OnStateChanged += HandleStateChanged;
        ThemeService.OnThemeChanged += HandleThemeChanged;

        // Initialize theme first (does not affect chat state)
        await ThemeService.InitializeAsync();

        // Initialize session if not already done
        if (!ChatSession.HasSession)
        {
            await ChatSession.InitializeSessionAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auto-scroll when new messages arrive or loading state changes
        var currentMessageCount = ChatSession.Messages.Count;
        var isLoading = ChatSession.IsLoading;

        if (currentMessageCount > _previousMessageCount || (isLoading && !_wasLoading) || (!isLoading && _wasLoading))
        {
            await ScrollToBottomAsync();
        }

        _previousMessageCount = currentMessageCount;
        _wasLoading = isLoading;
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollToBottom", _messagesContainer);
        }
        catch (JSException)
        {
            // Ignore JS interop errors (e.g., during prerendering)
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_inputMessage))
            return;

        var message = _inputMessage;
        _inputMessage = string.Empty;

        // Initialize session if needed
        if (!ChatSession.HasSession)
        {
            await ChatSession.InitializeSessionAsync();
        }

        await ChatSession.SendMessageAsync(message);
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleThemeChanged()
    {
        // Theme change does not affect chat history - just trigger UI re-render
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatSession.OnStateChanged -= HandleStateChanged;
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
