@page "/not-found"
@layout HealthPlanChat.Web.Layout.ChatLayout

<div class="not-found-container" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--color-text-primary);">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">404</h1>
    <h3>Page Not Found</h3>
    <p>Sorry, the page you are looking for does not exist.</p>
    <a href="/" style="color: var(--color-primary); margin-top: 1rem;">Go to Chat</a>
</div>
